# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Database (PostgreSQL)
# ==========================================
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evotec_assignment?schema=public"

# ==========================================
# JWT
# ==========================================
# Use long, random, unique secrets in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=replace_this_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_this_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Seeded Super Admin (created by `npm run seed`)
# ==========================================
SEED_ADMIN_EMAIL=admin@evotec.software
SEED_ADMIN_PASSWORD=ChangeMe123!

# ==========================================
# Rate limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
